# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# App secret
SECRET_KEY=your-secret-key

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://your-domain.com

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Upload: cf = Cloudflare R2 (boto3). Do not use aliyun oss2.
UPLOADTYPE=cf

# Cloudflare R2 — secrets only in real .env / Bot Secrets (never commit keys)
CLOUDFLARE_ACCOUNT_ID=9bd6393269b0934e28f5379a36e972f3
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_SECRET_KEY=
CLOUDFLARE_BUCKET=blog
# Optional override; default = https://{ACCOUNT_ID}.r2.cloudflarestorage.com
# CLOUDFLARE_ENDPOINT=https://9bd6393269b0934e28f5379a36e972f3.r2.cloudflarestorage.com
CLOUDFLARE_PUBLIC_BASE_URL=https://img.xiaoyu-hh.cn
CLOUDFLARE_REGION=auto

# Object key prefixes (new uploads; do not overwrite historical OSS/ keys)
UPLOAD_PREFIX=kirameku/
PHOTOWALL_PREFIX=photowall/

# Optional legacy fallbacks (also accepted if CLOUDFLARE_* unset):
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY
# OSS_ACCESS_KEY_ID / OSS_ACCESS_KEY_SECRET / OSS_BUCKET_NAME / OSS_ENDPOINT / OSS_CUSTOM_DOMAIN / OSS_PREFIX
